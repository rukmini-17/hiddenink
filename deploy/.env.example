# Create deploy/.env on the SERVER by typing these values. Never commit it; it is gitignored
# and never copied into any image. (compose reads it for interpolation + the server's env.)

# The sslip.io hostname for this server's public IP (Caddy gets HTTPS for it automatically).
SITE_ADDRESS=YOUR_IP.sslip.io

# Bearer token required by the HiddenInk API (same value your laptop uses for the MCP header).
HIDDENINK_TOKEN=change-me-to-a-strong-random-string

# Gemini (Layer 2 manifest + optional incident report).
GEMINI_API_KEY=your-gemini-api-key
# Flash-tier model for the manifest call; omit to use the default (gemini-3.5-flash-lite).
GEMINI_MANIFEST_MODEL=gemini-3.5-flash-lite
