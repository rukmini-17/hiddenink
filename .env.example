# Copy to .env and fill in. Never commit .env.

# --- HiddenInk server (Layer 1 / Layer 2) ---
# Bearer token required by /api/* on the server. Pick any strong random string for dev.
HIDDENINK_API_KEY=
# Same value, under a non-credential name, for the Claude Code MCP header (${HIDDENINK_TOKEN}).
HIDDENINK_TOKEN=
# Where clients (the agent) reach the server. Empty/omitted = http://localhost:8787
HIDDENINK_API_URL=

# --- Gemini (agent + Layer 2 manifest, R3) ---
GEMINI_API_KEY=

# --- Canary (demo) ---
# Where the canary package reports to (demo attacker service). Hard-coded in the wheel for
# local demos; set this only if you rebuild the wheel for a different host.
CANARY_URL=

# --- Extension (Stage 2 hook) ---
# Base URL of the HiddenInk server for the extension (empty = local-only mode).
SERVER_URL=
