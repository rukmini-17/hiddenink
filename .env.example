# Copy to .env and fill in. Never commit .env.

# --- HiddenInk server (Layer 1 / Layer 2) ---
# ONE token name everywhere (server auth, check.sh, and the Claude Code MCP header
# ${HIDDENINK_TOKEN}). Pick any strong random string for the demo.
HIDDENINK_TOKEN=
# Where clients reach the server. Empty/omitted = http://localhost:8787
HIDDENINK_API_URL=

# --- Gemini (Layer 2 manifest + optional incident report) ---
GEMINI_API_KEY=
# Flash-tier model for the structured-JSON manifest call (higher free limits).
# Default gemini-3.5-flash-lite; gemini-3.8-flash is the docs-confirmed structured-output
# alternative. On any failure the server falls back to server/fallback-manifest.json.
GEMINI_MANIFEST_MODEL=

# --- Canary (demo) ---
# Where the canary package reports to (demo attacker service). Hard-coded in the wheel for
# local demos; set this only if you rebuild the wheel for a different host.
CANARY_URL=

# --- Extension (Stage 2 hook) ---
# Base URL of the HiddenInk server for the extension (empty = local-only mode).
SERVER_URL=
